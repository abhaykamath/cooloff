PORT=8787
NODE_ENV=development

# Supabase (Project Settings → API). Service role key is server-only.
SUPABASE_URL=https://xxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Telegram — token from @BotFather; secret is any random string; chat id from the bot's /start reply
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_OWNER_CHAT_ID=
# polling (default in dev) or webhook (default in production)
# ⚠️ Polling deletes any registered webhook — don't run dev polling against the live bot.
TELEGRAM_MODE=

# Only for webhook mode off Render (Render provides RENDER_EXTERNAL_URL automatically). Must be https.
PUBLIC_API_URL=
# Not used yet (reserved for "Open dashboard" links in bot messages)
DASHBOARD_URL=

# Dashboard login
DASHBOARD_PASSWORD=
# Generate with: openssl rand -hex 32
SESSION_SECRET=

DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
COOLDOWN_HOURS=48
EXPIRE_AFTER_DAYS=7
