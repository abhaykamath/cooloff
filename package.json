{
  "name": "impulse-buying-circuit-breaker",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter api --filter web dev",
    "dev:api": "pnpm --filter api dev",
    "dev:web": "pnpm --filter web dev",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "db:types": "supabase gen types typescript --linked --schema public 2>/dev/null > packages/shared/src/database.types.ts"
  }
}
